@kirin 2
@entry rotation "过程周期证明（虚构）"
@status "example_only"

----
完全虚构的固定策略，用普通 Process 状态、flow、action 与 Scenario 决策表达；cycle analysis 只证明该有界场景边界状态的精确重复，不拥有资源或技能专用语义。
----

dimension mana "法力"
unit mana = mana
unit mana_per_time = mana / time

process resource_rotation "资源过程":
  input maximum_mana: mana = 100 mana
  input regeneration: mana_per_time = 10 mana_per_time
  input blast_cost: mana = 10 mana
  state mana: mana = maximum_mana in 0..maximum_mana
  action arcane_blast() when mana >= blast_cost
  flow mana(current, elapsed) = min(maximum_mana, current + regeneration * elapsed)
  on arcane_blast():
    next mana = mana - blast_cost
  observe current_mana: mana = mana

scenario main_rotation "固定技能策略":
  phases:
    - decision
  use actor = resource_rotation:
  action arcane_blast:
    send actor.arcane_blast() phase decision
  policy named_rotation:
    sequence:
      - arcane_blast
      - wait
      - arcane_blast
  decide every 1 second from 0 second until 2 second phase decision:
    - arcane_blast
    - wait
  measure ending_mana: mana = final(actor.current_mana)
  bounds:
    horizon = 2 second
    maximum_events = 2
    maximum_decisions = 3
    maximum_branches = 8
    maximum_entities = 1

analysis replay_rotation "重放固定策略":
  using = main_rotation
  operation = run
  policy = named_rotation

analysis prove_rotation "证明边界周期":
  using = main_rotation
  operation = cycle
  policy = named_rotation
