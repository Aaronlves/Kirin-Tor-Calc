@kirin 1
@entry example_semantics
@template semantics
@status example_only

// 验收示例基础数学语义

---
完全虚构的普通条目，用于证明量纲和通用值域不是内核特权。
---

dimensions:
  damage "伤害"
  time "时间"

units:
  damage = damage
  time = time
  damage_per_time = damage / time

domains:
  probability: number[dimensionless] in 0..1
  positive_integer: number[dimensionless] in 1..* integer
