@kirin 1
@entry brewmaster_semantics
@template semantics
@game-version 12.0.1.65617
@status workbook_reproduction

// 酒仙系数表复现所需的数学语义

dimensions:
  attack_power "攻击强度"
  damage "伤害"
  healing "治疗"
  armor "护甲"
  health "生命值"

units:
  attack_power = attack_power
  damage = damage
  healing = healing
  armor = armor
  health = health
  damage_per_attack_power = damage / attack_power
  healing_per_attack_power = healing / attack_power
  healing_per_health = healing / health
  rating_per_attack_power = 1 / attack_power
  rating_per_armor = 1 / armor

domains:
  probability: number[dimensionless] in 0..1
  target_count: number[dimensionless] in 1..20 integer
  nonnegative: number[dimensionless] in 0..*
