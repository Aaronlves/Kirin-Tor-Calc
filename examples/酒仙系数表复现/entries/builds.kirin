// 玩家参数方案

---
这些方案只改变列出的输入；其余输入继续使用条目默认值。
“当前表格”对应工作簿当前黄色输入区。
---

presets:
  current "当前表格":

  master_of_harmony "祥和宗师":
    damage_table.shadopan = false

  shadopan "影踪派":
    damage_table.shadopan = true

  single_target "单目标":
    aoe_table.targets = 1

  five_targets "5目标":
    aoe_table.targets = 5

  eight_targets "8目标":
    aoe_table.targets = 8

  twenty_targets "20目标":
    aoe_table.targets = 20
