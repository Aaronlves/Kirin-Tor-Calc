@kirin 1
@entry damage_table
@template model
@game-version 12.0.1.65617
@status workbook_reproduction

// 第 1 张表：伤害表

---
复现“酒仙技能攻强系数表 v2.1.xlsx”的第 1 张表。
保留当前黄色输入区的默认值和公式结构；这不是官方游戏数据声明。
---

sources:
  {"kind":"workbook","citation":"酒仙技能攻强系数表 v2.1.xlsx，第1张表 伤害表，A1:U31","game_version":"12.0.1.65617","verified_at":"2026-09-01"}

inputs:
  weapon_dps "武器秒伤": number[attack_power] = 77.5 in 0..*
  agility "敏捷": number[attack_power] = 2288 in 0..*
  haste_rating "急速绿字": nonnegative = 393
  mastery_rating "精通绿字": nonnegative = 609
  versatility_rating "全能绿字": nonnegative = 714
  shadopan "影踪派": boolean = false
  season_one_set "S1套装": boolean = false
  improved_blackout_kick "强化幻灭踢": boolean = true
  shadowboxing_treads "太极鞋": boolean = true
  elusive_footwork "醉踪步": boolean = true
  face_palm "迎面铁掌": boolean = true
  counterattack "反击": boolean = false
  blackout_combo "幻灭连击": boolean = false
  bring_me_another_3 "再来一杯3": boolean = true
  treasured_brew "珍藏酒酿": boolean = true
  celestial_flames "天神烈焰": boolean = false
  dragonfire_brew "龙焰酒": boolean = true
  heart_of_niuzao "玄牛之心": boolean = true
  scalding_brew "滚烫烧酒": boolean = false

fields:
  ap_to_damage: damage_per_attack_power = 1
  ap_to_healing: healing_per_attack_power = 1
  master_of_harmony: dimensionless := not shadopan
  effective_agility: attack_power := agility * if_else(shadopan, 1.04, 1)
  haste "急速": dimensionless :=
    if_else(shadopan, 0.05 + haste_rating / 4400, haste_rating / 4400)
  mastery "精通提升": dimensionless :=
    mastery_rating / 4600 + 0.08 + if_else(heart_of_niuzao, 0.05, 0)
  versatility "全能": dimensionless := versatility_rating / 5400
  base_attack_power "基础攻强": attack_power :=
    (weapon_dps * 6 + effective_agility) * (1 + mastery)
  physical_multiplier "物理增伤总乘数": dimensionless :=
    (1 + 0.04) * (1 + 0.04) * (1 + 0.20) * (1 + 0.05)
  magical_multiplier "魔法增伤总乘数": dimensionless :=
    (1 + 0.04) * (1 + 0.04)
  physical_armor_factor: dimensionless := if_else(shadopan, 0.736, 0.7)
  tier_set_multiplier: dimensionless = 1.1

  tiger_palm_initial: dimensionless := 90 * 1.73
  tiger_palm_after_armor: dimensionless := tiger_palm_initial * physical_armor_factor
  blackout_kick_initial: dimensionless := 84.7 * 1.92
  blackout_kick_after_armor: dimensionless := blackout_kick_initial * physical_armor_factor
  spinning_crane_kick_initial: dimensionless := 4 * 10 * 1.8
  spinning_crane_kick_after_armor: dimensionless :=
    spinning_crane_kick_initial * physical_armor_factor
  keg_smash_initial: dimensionless := if_else(treasured_brew, 190 * 1.5, 190)
  keg_smash_after_armor: dimensionless := keg_smash_initial * physical_armor_factor
  special_delivery_after_armor: dimensionless := 100 * physical_armor_factor
  niuzao_after_armor: dimensionless := 400 * physical_armor_factor
  breath_of_fire_dot_initial: dimensionless := 66 * (1 + haste)
  empty_keg_after_armor: dimensionless := 300 * physical_armor_factor
  rushing_jade_wind_after_armor: dimensionless := 13.3 * 9 * physical_armor_factor
  clear_the_cellar_after_armor: dimensionless := 200 * physical_armor_factor
  flurry_physical_after_armor: dimensionless := 60 * physical_armor_factor
  high_impact_after_armor: dimensionless := 100 * physical_armor_factor

outputs:
  tiger_palm_coefficient "猛虎掌最终系数": dimensionless =
    tiger_palm_after_armor * physical_multiplier *
    if_else(face_palm, 2, 1) *
    if_else(counterattack, 2, 1) *
    if_else(blackout_combo, 2.5, 1) *
    if_else(shadopan, 1.2, 1)
  tiger_palm_damage "猛虎掌预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * tiger_palm_coefficient / 100

  blackout_kick_coefficient "幻灭踢最终系数": dimensionless =
    blackout_kick_after_armor * physical_multiplier *
    if_else(improved_blackout_kick, 1.2, 1) *
    if_else(shadowboxing_treads, 1.2, 1) *
    if_else(elusive_footwork, 1.05, 1) * 1.2
  blackout_kick_damage "幻灭踢预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * blackout_kick_coefficient / 100

  spinning_crane_kick_coefficient "神鹤引项踢最终系数": dimensionless =
    spinning_crane_kick_after_armor * physical_multiplier * 1.1 *
    if_else(shadopan, 1.2, 1)
  spinning_crane_kick_damage "神鹤引项踢预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) *
    spinning_crane_kick_coefficient / 100

  keg_smash_coefficient "醉酿投最终系数": dimensionless =
    keg_smash_after_armor * physical_multiplier *
    if_else(season_one_set, tier_set_multiplier, 1) *
    if_else(shadopan, 1.35, 1) *
    if_else(shadopan, 1.2, 1) *
    if_else(scalding_brew, 1.2, 1)
  keg_smash_damage "醉酿投预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * keg_smash_coefficient / 100

  exploding_keg_coefficient "爆炸酒桶最终系数": dimensionless =
    380 * magical_multiplier
  exploding_keg_damage "爆炸酒桶预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * exploding_keg_coefficient / 100

  chi_burst_coefficient "真气爆裂最终系数": dimensionless =
    378 * magical_multiplier * if_else(master_of_harmony, 2, 1)
  chi_burst_damage "真气爆裂预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * chi_burst_coefficient / 100

  special_delivery_coefficient "特别快递最终系数": dimensionless =
    special_delivery_after_armor * physical_multiplier
  special_delivery_damage "特别快递预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * special_delivery_coefficient / 100

  niuzao_coefficient "玄牛伴身最终系数": dimensionless =
    niuzao_after_armor * physical_multiplier * if_else(shadopan, 1.2, 1)
  niuzao_damage "玄牛伴身预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * niuzao_coefficient / 100

  breath_of_fire_coefficient "火焰之息最终系数": dimensionless =
    100 * magical_multiplier * if_else(dragonfire_brew, 2, 1) *
    if_else(season_one_set, tier_set_multiplier, 1) * 2
  breath_of_fire_damage "火焰之息预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * breath_of_fire_coefficient / 100

  dragonfire_tick_coefficient "单次龙焰酒最终系数": dimensionless =
    20 * magical_multiplier * if_else(dragonfire_brew, 2, 1) *
    if_else(season_one_set, tier_set_multiplier, 1)
  dragonfire_tick_damage "单次龙焰酒预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * dragonfire_tick_coefficient / 100

  breath_of_fire_dot_coefficient "火焰之息DOT最终系数": dimensionless =
    breath_of_fire_dot_initial * magical_multiplier *
    if_else(season_one_set, tier_set_multiplier, 1)
  breath_of_fire_dot_damage "火焰之息DOT预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) *
    breath_of_fire_dot_coefficient / 100

  empty_keg_coefficient "空酒桶最终系数": dimensionless =
    empty_keg_after_armor * physical_multiplier *
    if_else(bring_me_another_3, 2, 1)
  empty_keg_damage "空酒桶预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * empty_keg_coefficient / 100

  rushing_jade_wind_coefficient "碧玉疾风最终系数": dimensionless =
    rushing_jade_wind_after_armor * physical_multiplier *
    if_else(
    celestial_flames,
    ((1 + 3/7) * (1 + 0.04)) / ((1 + 0.05) * (1 + 0.04)),
    1
    )
  rushing_jade_wind_damage "碧玉疾风预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) *
    rushing_jade_wind_coefficient / 100

  season_two_set_coefficient "S2套装最终系数": dimensionless =
    50 * physical_multiplier
  season_two_set_damage "S2套装预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) *
    season_two_set_coefficient / 100

  crackling_jade_lightning_coefficient "碎玉闪电最终系数": dimensionless =
    28 * magical_multiplier * if_else(shadopan, 1.2, 1)
  crackling_jade_lightning_damage "碎玉闪电预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) *
    crackling_jade_lightning_coefficient / 100

  fuel_on_the_fire_coefficient "火上浇油最终系数": dimensionless =
    200 * magical_multiplier
  fuel_on_the_fire_damage "火上浇油预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) *
    fuel_on_the_fire_coefficient / 100

  clear_the_cellar_coefficient "清空酒窖最终系数": dimensionless =
    clear_the_cellar_after_armor * physical_multiplier
  clear_the_cellar_damage "清空酒窖预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) *
    clear_the_cellar_coefficient / 100

  aflame_coefficient "Aflame最终系数": dimensionless = 25 * magical_multiplier
  aflame_damage "Aflame预测伤害": damage =
    base_attack_power * ap_to_damage * (1 + versatility) * aflame_coefficient / 100

  flurry_normal_coefficient "疾风乱打N最终系数": dimensionless =
    41.6 * magical_multiplier
  flurry_normal_damage "疾风乱打N预测伤害": damage =
    if_else(
    shadopan,
    base_attack_power * ap_to_damage * (1 + versatility) * flurry_normal_coefficient / 100,
    0
    )
  flurry_physical_coefficient "疾风乱打P最终系数": dimensionless =
    flurry_physical_after_armor * physical_multiplier
  flurry_physical_damage "疾风乱打P预测伤害": damage =
    if_else(
    shadopan,
    base_attack_power * ap_to_damage * (1 + versatility) * flurry_physical_coefficient / 100,
    0
    )
  high_impact_coefficient "拳劲贯体最终系数": dimensionless =
    high_impact_after_armor * physical_multiplier
  high_impact_damage "拳劲贯体预测伤害": damage =
    if_else(
    shadopan,
    base_attack_power * ap_to_damage * (1 + versatility) * high_impact_coefficient / 100,
    0
    )

  harmonic_surge_coefficient "和谐涌动最终系数": dimensionless =
    220 * magical_multiplier
  harmonic_surge_damage "和谐涌动预测伤害": damage =
    if_else(
    master_of_harmony,
    base_attack_power * ap_to_damage * 0.96 * (1 + versatility) *
    harmonic_surge_coefficient / 100,
    0
    )

groups:
  predicted_damage "预测伤害":
    tiger_palm_damage
    blackout_kick_damage
    spinning_crane_kick_damage
    keg_smash_damage
    exploding_keg_damage
    chi_burst_damage
    special_delivery_damage
    niuzao_damage
    breath_of_fire_damage
    dragonfire_tick_damage
    breath_of_fire_dot_damage
    empty_keg_damage
    rushing_jade_wind_damage
    season_two_set_damage
    crackling_jade_lightning_damage
    fuel_on_the_fire_damage
    clear_the_cellar_damage
    aflame_damage
    flurry_normal_damage
    flurry_physical_damage
    high_impact_damage
    harmonic_surge_damage

  coefficients "攻强系数":
    tiger_palm_coefficient
    blackout_kick_coefficient
    spinning_crane_kick_coefficient
    keg_smash_coefficient
    exploding_keg_coefficient
    chi_burst_coefficient
    special_delivery_coefficient
    niuzao_coefficient
    breath_of_fire_coefficient
    dragonfire_tick_coefficient
    breath_of_fire_dot_coefficient
    empty_keg_coefficient
    rushing_jade_wind_coefficient
    season_two_set_coefficient
    crackling_jade_lightning_coefficient
    fuel_on_the_fire_coefficient
    clear_the_cellar_coefficient
    aflame_coefficient
    flurry_normal_coefficient
    flurry_physical_coefficient
    high_impact_coefficient
    harmonic_surge_coefficient

display:
  tiger_palm_damage: integer
  blackout_kick_damage: integer
  spinning_crane_kick_damage: integer
  keg_smash_damage: integer
  exploding_keg_damage: integer
  chi_burst_damage: integer
  special_delivery_damage: integer
  niuzao_damage: integer
  breath_of_fire_damage: integer
  dragonfire_tick_damage: integer
  breath_of_fire_dot_damage: integer
  empty_keg_damage: integer
  rushing_jade_wind_damage: integer
  season_two_set_damage: integer
  crackling_jade_lightning_damage: integer
  fuel_on_the_fire_damage: integer
  clear_the_cellar_damage: integer
  aflame_damage: integer
  flurry_normal_damage: integer
  flurry_physical_damage: integer
  high_impact_damage: integer
  harmonic_surge_damage: integer
  tiger_palm_coefficient: coefficient_percent digits 2
  blackout_kick_coefficient: coefficient_percent digits 2
  spinning_crane_kick_coefficient: coefficient_percent digits 2
  keg_smash_coefficient: coefficient_percent digits 2
  exploding_keg_coefficient: coefficient_percent digits 2
  chi_burst_coefficient: coefficient_percent digits 2
  special_delivery_coefficient: coefficient_percent digits 2
  niuzao_coefficient: coefficient_percent digits 2
  breath_of_fire_coefficient: coefficient_percent digits 2
  dragonfire_tick_coefficient: coefficient_percent digits 2
  breath_of_fire_dot_coefficient: coefficient_percent digits 2
  empty_keg_coefficient: coefficient_percent digits 2
  rushing_jade_wind_coefficient: coefficient_percent digits 2
  season_two_set_coefficient: coefficient_percent digits 2
  crackling_jade_lightning_coefficient: coefficient_percent digits 2
  fuel_on_the_fire_coefficient: coefficient_percent digits 2
  clear_the_cellar_coefficient: coefficient_percent digits 2
  aflame_coefficient: coefficient_percent digits 2
  flurry_normal_coefficient: coefficient_percent digits 2
  flurry_physical_coefficient: coefficient_percent digits 2
  high_impact_coefficient: coefficient_percent digits 2
  harmonic_surge_coefficient: coefficient_percent digits 2
