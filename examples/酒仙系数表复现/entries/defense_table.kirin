@kirin 1
@entry defense_table
@template model
@game-version 12.0.1.65617
@status workbook_reproduction

// 第 3 张表：防御表

---
复现工作簿第 3 张表的防御、治疗和减伤公式。
第 3 张表 N3 对第 4 张表 H2 的引用由 dodge_expectation 动态计算。
---

sources:
  {"kind":"workbook","citation":"酒仙技能攻强系数表 v2.1.xlsx，第3张表 防御表，A1:U32","game_version":"12.0.1.65617","verified_at":"2026-09-01"}

inputs:
  armor_constant "内容护甲常数": number[armor] = 4531.0301 in 0..*
  health_fraction "当前生命比例": probability = 1
  stamina "耐力换算生命": number[health] = 56268 in 0..*
  base_agility "基础敏捷": number[attack_power] = 620 in 0..*
  agility_per_dodge_point "敏捷躲闪换算P值": number[attack_power] = 191.35 in 0..*
  armor_value "护甲值": number[armor] = 0 in 0..*
  miss_rate "未命中率": probability = 0.02
  night_elf "暗夜精灵": boolean = false
  parry_rate "招架率": probability = 0.03
  crit_rating "暴击绿字": nonnegative = 1091

  save_them_all "普渡众生": boolean = true
  vigorous_expulsion "生机蓬勃": boolean = true
  strength_of_spirit "灵魂之力": boolean = true
  niuzao_resolve "砮皂的决心": boolean = false
  pretense_of_instability "无常虚妄": boolean = true
  fortifying_brew_determination "壮胆酒决绝": boolean = false
  high_tolerance_one "坚定不屈1": boolean = true
  high_tolerance_two "坚定不屈2": boolean = false
  ox_stance "玄牛式": boolean = true
  zen_state "禅悟状态": boolean = false

fields:
  healing_from_ap: healing_per_attack_power = 1
  healing_from_health: healing_per_health = 1
  rating_from_ap: rating_per_attack_power = 1
  rating_from_armor: rating_per_armor = 1
  max_health "最大生命上限": health := stamina * 20
  additional_agility: attack_power := damage_table.effective_agility - base_agility
  crit_rate "暴击率": dimensionless := 0.10 + crit_rating / 4600

  calming_presence: dimensionless = 0.03
  flow_of_chi: dimensionless = 0.05
  silent_sanctuary: dimensionless = 0.10
  grace_of_crane: dimensionless = 0.04
  chi_proficiency: dimensionless = 0.04
  dance_of_wind: dimensionless = 0.05
  martial_instincts: dimensionless = 0.04
  vigorous_expulsion_bonus: dimensionless = 0.06
  shuffle_multiplier: dimensionless = 3.43
  pretense_bonus: dimensionless = 0.10
  determination_multiplier: dimensionless = 1.5
  high_tolerance_one_multiplier: dimensionless = 1.1
  high_tolerance_two_multiplier: dimensionless = 1.2
  ox_stance_multiplier: dimensionless = 1.4

  healing_taken_multiplier "受到治疗乘数": dimensionless :=
    (1 + grace_of_crane) *
    if_else(health_fraction < 0.35, 1 + silent_sanctuary, 1)
  healing_done_multiplier "造成治疗乘数": dimensionless :=
    (1 + chi_proficiency) *
    if_else(save_them_all, 1 + (1 - health_fraction) / 10, 1)
  general_damage_reduction "通用伤害减免": dimensionless :=
    1 - (1 - calming_presence) *
    if_else(
    health_fraction >= 0.35 and health_fraction <= 0.90,
    1 - flow_of_chi,
    1
    )

  stagger_rating: dimensionless :=
    damage_table.effective_agility * rating_from_ap * 1.13 * shuffle_multiplier *
    if_else(fortifying_brew_determination, determination_multiplier, 1) *
    if_else(
    high_tolerance_two,
    high_tolerance_two_multiplier,
    if_else(high_tolerance_one, high_tolerance_one_multiplier, 1)
    ) *
    if_else(ox_stance, ox_stance_multiplier, 1) *
    if_else(zen_state, 1.8 - 0.8 * health_fraction, 1)

  expel_harm_initial: dimensionless = 120
  vivify_initial: dimensionless := 258 * 1.92 * 1.4
  silent_sanctuary_initial: dimensionless := 300 * 1.25
  healing_sphere_initial: dimensionless = 330
  refreshing_drink_initial: dimensionless = 3200
  harmonic_surge_healing_initial: dimensionless = 50
  celestial_brew_initial: dimensionless := 2268 * 1.25
  celestial_infusion_initial: dimensionless := 2268 * 1.25
  awakening_spirit_initial: dimensionless = 600
  mantra_of_purity_initial: dimensionless = 100
  mantra_of_tenacity_initial: dimensionless = 12

outputs:
  stagger_absorption "醉拳吸收系数": dimensionless =
    stagger_rating / (stagger_rating + armor_constant * rating_from_armor)
  armor_reduction "护甲减伤": dimensionless =
    armor_value / (armor_value + armor_constant)
  base_dodge "基础躲闪率": dimensionless =
    (3 + base_agility / agility_per_dodge_point +
    (additional_agility / agility_per_dodge_point) /
    ((additional_agility / agility_per_dodge_point) * 0.01 + 100 / 94)) / 100 +
    dance_of_wind + if_else(pretense_of_instability, pretense_bonus, 0)
  ramping_dodge "递增躲闪率": dimensionless = 0.92 * damage_table.mastery

  base_physical_reduction "总物伤减免": dimensionless =
    1 - (1 - general_damage_reduction) * (1 - armor_reduction) *
    (1 - stagger_absorption) * (1 - damage_table.versatility / 2)
  base_magical_reduction "总法伤减免": dimensionless =
    1 - (1 - general_damage_reduction) * (1 - stagger_absorption * 0.58) *
    (1 - damage_table.versatility / 2)
  expected_physical_reduction "期望物理减免": dimensionless =
    1 - (1 - base_physical_reduction) *
    (1 - dodge_expectation.expected_dodge - parry_rate - miss_rate -
    if_else(night_elf, 0.02, 0))

  expel_harm_coefficient "移花接木治疗系数": dimensionless =
    expel_harm_initial * healing_taken_multiplier * healing_done_multiplier *
    if_else(strength_of_spirit, 2 - health_fraction, 1) *
    if_else(vigorous_expulsion, 1 + vigorous_expulsion_bonus, 1) * 1.04 * 1.04
  expel_harm_healing "移花接木预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap * 0.96 *
    (1 + damage_table.versatility) * expel_harm_coefficient / 100

  vivify_coefficient "活血术治疗系数": dimensionless =
    vivify_initial * healing_taken_multiplier * healing_done_multiplier
  vivify_healing "活血术预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap * 0.96 *
    (1 + damage_table.versatility) * vivify_coefficient / 100

  silent_sanctuary_coefficient "静谧之所治疗系数": dimensionless =
    silent_sanctuary_initial * healing_taken_multiplier
  silent_sanctuary_healing "静谧之所预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap * 0.96 *
    (1 + damage_table.versatility) * silent_sanctuary_coefficient / 100

  healing_sphere_coefficient "疗伤珠治疗系数": dimensionless =
    healing_sphere_initial * healing_taken_multiplier * healing_done_multiplier *
    if_else(niuzao_resolve, 1.8 - 0.8 * health_fraction, 1)
  healing_sphere_healing "疗伤珠预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap *
    (1 + damage_table.versatility) * healing_sphere_coefficient / 100

  refreshing_drink_coefficient "提神饮料治疗系数": dimensionless =
    refreshing_drink_initial * healing_taken_multiplier * healing_done_multiplier
  refreshing_drink_healing "提神饮料预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap *
    (1 + damage_table.versatility) * refreshing_drink_coefficient / 100

  harmonic_surge_healing_coefficient "和谐涌动治疗系数": dimensionless =
    if_else(
    damage_table.master_of_harmony,
    harmonic_surge_healing_initial * healing_taken_multiplier * healing_done_multiplier,
    0
    )
  harmonic_surge_healing "和谐涌动预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap * 0.96 *
    (1 + damage_table.versatility) * harmonic_surge_healing_coefficient / 100

  celestial_brew_coefficient "天神酒吸收系数": dimensionless =
    celestial_brew_initial * healing_taken_multiplier
  celestial_brew_absorb "天神酒预测吸收": healing =
    damage_table.base_attack_power * healing_from_ap *
    (1 + damage_table.versatility) * celestial_brew_coefficient / 100 *
    (1 + crit_rate * 0.70)

  celestial_infusion_coefficient "天神灌注吸收系数": dimensionless =
    celestial_infusion_initial * healing_taken_multiplier
  celestial_infusion_absorb "天神灌注预测吸收": healing =
    damage_table.base_attack_power * healing_from_ap *
    (1 + damage_table.versatility) * celestial_infusion_coefficient / 100 *
    (1 + crit_rate * 0.70)

  awakening_spirit_coefficient "觉醒之魂治疗系数": dimensionless =
    awakening_spirit_initial * healing_done_multiplier
  awakening_spirit_healing "觉醒之魂预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap *
    (1 + damage_table.versatility) * awakening_spirit_coefficient / 100 *
    (1 + crit_rate * 0.70)

  mantra_of_purity_coefficient "纯净真言治疗系数": dimensionless =
    if_else(
    damage_table.master_of_harmony,
    mantra_of_purity_initial * healing_done_multiplier,
    0
    )
  mantra_of_purity_healing "纯净真言预测治疗": healing =
    damage_table.base_attack_power * healing_from_ap *
    (1 + damage_table.versatility) * mantra_of_purity_coefficient / 100 *
    (1 + crit_rate * 0.70)

  mantra_of_tenacity_coefficient "坚韧真言生命系数": dimensionless =
    if_else(damage_table.master_of_harmony, mantra_of_tenacity_initial, 0)
  mantra_of_tenacity_healing "坚韧真言预测生命": healing =
    if_else(
    damage_table.master_of_harmony,
    max_health * healing_from_health * mantra_of_tenacity_coefficient / 100 *
    (1 + damage_table.versatility) * (1 + crit_rate * 0.70),
    0
    )

groups:
  mitigation "减伤与躲闪":
    stagger_absorption
    armor_reduction
    base_dodge
    ramping_dodge
    base_physical_reduction
    base_magical_reduction
    expected_physical_reduction

  healing_absorb "治疗与吸收":
    expel_harm_healing
    vivify_healing
    silent_sanctuary_healing
    healing_sphere_healing
    refreshing_drink_healing
    harmonic_surge_healing
    celestial_brew_absorb
    celestial_infusion_absorb
    awakening_spirit_healing
    mantra_of_purity_healing
    mantra_of_tenacity_healing

  coefficients "治疗与吸收系数":
    expel_harm_coefficient
    vivify_coefficient
    silent_sanctuary_coefficient
    healing_sphere_coefficient
    refreshing_drink_coefficient
    harmonic_surge_healing_coefficient
    celestial_brew_coefficient
    celestial_infusion_coefficient
    awakening_spirit_coefficient
    mantra_of_purity_coefficient
    mantra_of_tenacity_coefficient

display:
  stagger_absorption: percent digits 2
  armor_reduction: percent digits 2
  base_dodge: percent digits 2
  ramping_dodge: percent digits 2
  base_physical_reduction: percent digits 2
  base_magical_reduction: percent digits 2
  expected_physical_reduction: percent digits 2
  expel_harm_healing: integer
  vivify_healing: integer
  silent_sanctuary_healing: integer
  healing_sphere_healing: integer
  refreshing_drink_healing: integer
  harmonic_surge_healing: integer
  celestial_brew_absorb: integer
  celestial_infusion_absorb: integer
  awakening_spirit_healing: integer
  mantra_of_purity_healing: integer
  mantra_of_tenacity_healing: integer
  expel_harm_coefficient: coefficient_percent digits 2
  vivify_coefficient: coefficient_percent digits 2
  silent_sanctuary_coefficient: coefficient_percent digits 2
  healing_sphere_coefficient: coefficient_percent digits 2
  refreshing_drink_coefficient: coefficient_percent digits 2
  harmonic_surge_healing_coefficient: coefficient_percent digits 2
  celestial_brew_coefficient: coefficient_percent digits 2
  celestial_infusion_coefficient: coefficient_percent digits 2
  awakening_spirit_coefficient: coefficient_percent digits 2
  mantra_of_purity_coefficient: coefficient_percent digits 2
  mantra_of_tenacity_coefficient: coefficient_percent digits 2
