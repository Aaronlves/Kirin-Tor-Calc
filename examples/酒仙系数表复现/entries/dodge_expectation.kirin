@kirin 1
@entry dodge_expectation
@game-version 12.0.1.65617
@status workbook_reproduction

// 递增躲闪期望

---
复现原工作簿第 4 张表中被防御表引用的有限离散期望。
每次未躲闪后，下一次攻击使用更高的面板躲闪率；最多展开 16 次攻击。
---

sources:
  {"kind":"workbook_dependency","citation":"酒仙技能攻强系数表 v2.1.xlsx，总躲闪率计算表 A1:H20","game_version":"12.0.1.65617","verified_at":"2026-09-01"}

inputs:
  stagger_severity_bonus "醉拳程度额外躲闪": probability = 0.15 one-of [0, 0.05, 0.10, 0.15]

fields:
  increment: dimensionless =
    defense_table.ramping_dodge + 0.92 * stagger_severity_bonus
  exact_1: dimensionless = min(defense_table.base_dodge, 1)
  exact_2: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 1) *
    min(defense_table.base_dodge + increment, 1)
  exact_3: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 2) *
    min(defense_table.base_dodge + 2 * increment, 1)
  exact_4: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 3) *
    min(defense_table.base_dodge + 3 * increment, 1)
  exact_5: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 4) *
    min(defense_table.base_dodge + 4 * increment, 1)
  exact_6: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 5) *
    min(defense_table.base_dodge + 5 * increment, 1)
  exact_7: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 6) *
    min(defense_table.base_dodge + 6 * increment, 1)
  exact_8: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 7) *
    min(defense_table.base_dodge + 7 * increment, 1)
  exact_9: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 8) *
    min(defense_table.base_dodge + 8 * increment, 1)
  exact_10: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 9) *
    min(defense_table.base_dodge + 9 * increment, 1)
  exact_11: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 10) *
    min(defense_table.base_dodge + 10 * increment, 1)
  exact_12: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 11) *
    min(defense_table.base_dodge + 11 * increment, 1)
  exact_13: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 12) *
    min(defense_table.base_dodge + 12 * increment, 1)
  exact_14: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 13) *
    min(defense_table.base_dodge + 13 * increment, 1)
  exact_15: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 14) *
    min(defense_table.base_dodge + 14 * increment, 1)
  exact_16: dimensionless =
    product(1 - min(defense_table.base_dodge + (i - 1) * increment, 1), i, 1, 15) *
    min(defense_table.base_dodge + 15 * increment, 1)

  expected_attacks_before_dodge: dimensionless =
    exact_1 + 2 * exact_2 + 3 * exact_3 + 4 * exact_4 +
    5 * exact_5 + 6 * exact_6 + 7 * exact_7 + 8 * exact_8 +
    9 * exact_9 + 10 * exact_10 + 11 * exact_11 + 12 * exact_12 +
    13 * exact_13 + 14 * exact_14 + 15 * exact_15 + 16 * exact_16

outputs:
  expected_dodge "期望躲闪率": dimensionless =
    1 / expected_attacks_before_dodge

groups:
  defense "防御":
    expected_dodge

display:
  expected_dodge: percent digits 2
