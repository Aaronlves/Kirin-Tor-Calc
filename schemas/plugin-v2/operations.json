  "proposal.submit": {
    "allow_artifacts": false,
    "allow_durable_run": false,
    "allow_unsaved_overlays": true,
    "execution": "sync",
    "handler": "proposal",
    "hard_limits": {
      "bindings": 64,
      "bytes": 800000,
      "changes": 16
    },
    "permission": "proposal.submit",
    "request_schema": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "bindings": {
                    "additionalProperties": {
                      "maxLength": 2000,
                      "minLength": 1,
                      "type": "string"
                    },
                    "maxProperties": 64,
                    "type": "object"
                  },
                  "document_id": {
                    "maxLength": 240,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "create-from-template"
                  },
                  "template": {
                    "maxLength": 500,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "template",
                  "document_id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "document_id": {
                    "maxLength": 240,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "create-document"
                  },
                  "text": {
                    "maxLength": 400000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "document_id",
                  "text"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "base_sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "key": {
                    "maxLength": 500,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "replace-document"
                  },
                  "text": {
                    "maxLength": 400000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "key",
                  "base_sha256",
                  "text"
                ],
                "type": "object"
              }
            ]
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "description": {
          "maxLength": 500,
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "revision",
        "title",
        "changes"
      ],
      "type": "object"
    },
    "result_schema": {
      "$ref": "protocol.schema.json#/$defs/actionResult"
    },
    "timeout_class": "none",
    "unload_policy": "none"
  },
