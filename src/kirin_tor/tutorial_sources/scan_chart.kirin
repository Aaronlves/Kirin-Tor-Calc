@kirin 2
@entry tutorial_curve "教程 3：扫描与图表"
@status "tutorial"

----
完全虚构、游戏中立的教学数据。
图表是当前源码的只读投影；修改扫描配置不会创建另一份计算定义。
----

input investment "投入": number[dimensionless] = 0 in 0..10

field base "基础收益": dimensionless = 10

output linear "线性收益": dimensionless = base + 3 * investment

output diminishing "递减收益": dimensionless = base + 8 * (sqrt(investment + 1) - 1)

chart preview "投入与收益（虚构）":
  x = tutorial_curve.investment
  range = 0..10
  points = 21
  y:
    - tutorial_curve.linear as "线性收益"
    - tutorial_curve.diminishing as "递减收益"
  x_label = "投入"
  y_label = "收益"
  export_svg = "results/tutorial-curve.svg"
  export_csv = "results/tutorial-curve.csv"
