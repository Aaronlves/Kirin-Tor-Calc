@kirin 2
@entry tutorial_variants "教程 2：参数方案与比较"
@status "tutorial"

----
完全虚构、游戏中立的教学数据。
参数方案只保存对正式输入的具名赋值，不改变输入本身的身份。
----

input base "基础值": number[dimensionless] = 100 in 0..*

input rate "增长率": probability = 0.20

input bonus "固定增量": number[dimensionless] = 10 in 0..*

field scaled "比例结果": dimensionless = base * (1 + rate)

output proportional "比例方案": dimensionless = scaled
display proportional = number digits 2

output combined "组合方案": dimensionless = scaled + bonus
display combined = number digits 2

group comparison "方案比较":
  - proportional
  - combined

preset baseline "基线假设":
  tutorial_variants.rate = 0.20
  tutorial_variants.bonus = 10

preset alternative "另一组假设":
  tutorial_variants.rate = 0.35
  tutorial_variants.bonus = 5
